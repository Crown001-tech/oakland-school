  @@map("student_behaviour")
}

model StudentTimeline {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  eventType   String    @map("event_type") @db.VarChar(50)
  title       String    @db.VarChar(150)
  description String?
  metadata    Json?     @default("{}")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("student_timeline")
}

model TimetableVersion {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String    @db.VarChar(100)
  academicYear       String    @map("academic_year") @db.VarChar(50)
  term               String    @db.VarChar(50)
  status             String    @db.VarChar(30)
  conflictCount      Int?      @default(0) @map("conflict_count")
  satisfactionScore  Decimal?  @default(100.0) @map("satisfaction_score") @db.Decimal(5, 2)
