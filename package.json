{
  "name": "oakland-school-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter oakland-school dev",
    "dev:frontend": "pnpm --filter oakland-school dev",
    "dev:backend": "pnpm --filter oakland-school-backend dev",
    "build:frontend": "pnpm --filter oakland-school build",
    "build:backend": "pnpm --filter oakland-school-backend build",
    "build": "pnpm --filter oakland-school-backend build && pnpm --filter oakland-school build",
    "start:frontend": "pnpm --filter oakland-school start",
    "start:backend": "pnpm --filter oakland-school-backend start",
    "lint": "pnpm --filter oakland-school lint"
  }
}
